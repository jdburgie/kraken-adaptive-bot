# ── Kraken API credentials ───────────────────────────────────────────────────
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# ── Trading pair & timeframe ─────────────────────────────────────────────────
SYMBOL=BTC/USD
TIMEFRAME=1h          # 1h recommended — matches backtest data

# ── Safety ──────────────────────────────────────────────────────────────────
DRY_RUN=true          # KEEP TRUE until you've reviewed backtest results

# ── Risk management (read the docs before changing these) ────────────────────
# RISK_PCT: % of account balance AT RISK per trade.
# Position size is auto-calculated so a stop loss hit = exactly RISK_PCT loss.
# Start at 0.01 (1%) while learning. Never exceed 0.05 (5%) on a single trade.
RISK_PCT=0.01         # 1% of balance at risk per trade
STOP_PCT=0.030          # 3.0% trailing stop
TAKE_PCT=0.080          # 8% take profit

# ── Strategy parameters ──────────────────────────────────────────────────────
EMA_FAST=50           # fast EMA (trend confirmation)
EMA_SLOW=200          # slow EMA (primary trend filter — only trade with the trend)
BB_PERIOD=20          # Bollinger Band period
BB_STD=2.0            # Bollinger Band standard deviation multiplier
RSI_PERIOD=14
RSI_BUY=42            # enter when RSI below this (oversold in uptrend)
RSI_SELL=70

# ── Internal ─────────────────────────────────────────────────────────────────
CANDLE_LIMIT=250      # candles to fetch per tick (must exceed EMA_SLOW + buffer)
