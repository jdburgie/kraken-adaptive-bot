[Unit]
Description=Kraken Adaptive Crypto Bot
After=network.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/kraken-adaptive-bot
EnvironmentFile=/home/ec2-user/kraken-adaptive-bot/.env
ExecStart=/home/ec2-user/kraken-adaptive-bot/.venv/bin/python -m bots.main
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto-bot

[Install]
WantedBy=multi-user.target
